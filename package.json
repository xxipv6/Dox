{
  "name": "dox",
  "version": "0.1.0",
  "description": "Dox - 跨平台 SSH 终端与 SFTP 文件管理器",
  "type": "module",
  "main": "./out/main/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xxipv6/Dox.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "pack": "npm run typecheck && npm run build && electron-builder",
    "pack:win": "npm run typecheck && npm run build && electron-builder --win",
    "pack:mac": "npm run typecheck && npm run build && electron-builder --mac",
    "pack:linux": "npm run typecheck && npm run build && electron-builder --linux"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "ssh2": "^1.17.0",
    "zmodem.js": "^0.1.10"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.11",
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^24.10.1",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0-beta.1",
    "pinia": "^4.0.3",
    "playwright": "^1.63.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron@44.3.0": true,
    "node-pty@1.1.0": true
  }
}
